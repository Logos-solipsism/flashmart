# 可选：需要覆盖默认值时使用。不设置也能跑，application.yml 里每一项都有本地默认值——
# 例外是 JWT_SECRET 与 AGENT_SERVICE_TOKEN：它们都没有默认值，必须在这里（或环境变量里）显式提供。

MYSQL_HOST=localhost
MYSQL_PORT=13307
MYSQL_PASSWORD=root123456

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis123456

ROCKETMQ_NAMESERVER=localhost:9877

# JWT_SECRET 必须换成你自己的随机串（≥32 字节，可用 `openssl rand -hex 32` 生成）；
# 下面这行只是占位值，照抄可以让服务起来，但绝不能用于任何真实环境。
JWT_SECRET=replace-with-your-own-random-secret-min-32-bytes

# 外部 Agent 服务调用 /api/agent/** 时携带的 X-Agent-Token。
# 没有默认值：这一项为空（或未设置）时，/api/agent/** 的全部请求一律 401（fail-closed），
# 这是刻意的——漏配一个环境变量不该把活动与订单数据对外开放。
# 生成方式同上：openssl rand -hex 32
AGENT_SERVICE_TOKEN=replace-with-your-own-random-agent-token
